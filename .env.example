# MindSync configuration (copy to your shell profile or a local .env loader)
# Local-only mode needs nothing set — defaults write under ~/.mindsync

# MINDSYNC_HOME=~/.mindsync

# --- Optional remote durable sync (both required to enable) ---
# MINDSYNC_SSH_HOST=my-server
# MINDSYNC_REMOTE_ROOT=/opt/mindsync

# Optional remote layout overrides (paths relative to MINDSYNC_REMOTE_ROOT)
# MINDSYNC_REMOTE_ENV_FILE=config/mindsync.env
# MINDSYNC_REMOTE_WRITE_SCRIPT=tools/mindsync_fact.py
# MINDSYNC_REMOTE_CONSOLIDATE_SCRIPT=tools/mindsync_consolidate.py
# MINDSYNC_REMOTE_TRUTH_SUBDIR=compiled-truth

# MINDSYNC_SSH_TIMEOUT=3
# MINDSYNC_FOCUS_STALE_SECS=7200
# MINDSYNC_REMOTE_CACHE_TTL=30
# MINDSYNC_LOCK_TIMEOUT=5

# --- Optional interactive remote-dispatch worker ---
# MINDSYNC_WORKER_ID=laptop-worker
# MINDSYNC_WORKER_POLL_SECS=30
# MINDSYNC_WORKER_CLAIM_STALE_SECS=300
# MINDSYNC_WORKER_ALLOWED_ROOTS=C:\work\project1;C:\work\project2
