{
  "name": "codex",
  "displayName": "OpenAI Codex CLI",
  "bin": "codex",
  "input": "stdin",
  "runArgs": ["exec", "--skip-git-repo-check", "-"],
  "writeArgs": ["--sandbox", "workspace-write"],
  "modelArgs": ["--model", "{model}"],
  "effortArgs": ["-c", "model_reasoning_effort={effort}"],
  "efforts": ["low", "medium", "high"],
  "authCheckArgs": ["login", "status"],
  "loginHint": "codex login",
  "installHint": "npm install -g @openai/codex",
  "capabilities": ["general", "coding", "debugging", "testing", "devops", "repository", "review", "refactoring"],
  "capabilityWeights": {"coding": 100, "debugging": 95, "testing": 95, "devops": 90, "repository": 90, "review": 75, "refactoring": 80},
  "routingPriority": 80
}
