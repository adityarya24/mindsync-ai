{
  "name": "cursor",
  "displayName": "Cursor CLI",
  "bin": "cursor-agent",
  "input": "stdin",
  "runArgs": ["-p", "--output-format", "text"],
  "writeArgs": ["--force"],
  "modelArgs": ["--model", "{model}"],
  "loginHint": "cursor-agent login",
  "installHint": "See https://cursor.com/cli",
  "capabilities": ["general", "coding", "repository", "debugging"],
  "capabilityWeights": {"repository": 95, "coding": 85, "debugging": 85},
  "routingPriority": 65
}
